APP_NAME=PVP tetris
PORT=8880
NODE_ENV=development

JWT_SECRET=change_me
TOKEN_LIFETIME=7

# Local PostgreSQL connection. Use DATABASE_URL instead if your host provides it.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=pvp_tetris
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Render/Supabase alternative:
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_SSL=true

# Recommended for Render Free: HTTPS email API, not SMTP ports 25/465/587.
# Pick one provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your_brevo_api_key

EMAIL_FROM=PVP Tetris <noreply@your-domain.com>
EMAIL_FROM_NAME=PVP Tetris

# SMTP fallback for local development or paid hosts that allow SMTP.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=your_google_email@gmail.com
EMAIL_PASS=your_google_app_password
