APP_NAME=PVP tetris
PORT=8880
NODE_ENV=development
DATABASE_MODE=local

JWT_SECRET=change_me
TOKEN_LIFETIME=7
# 32 utf8 chars, 64 hex chars, or base64 value that decodes to 32 bytes.
CHAT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# DATABASE_MODE:
# - production (default when unset): uses DATABASE_URL first, then DB_*.
# - local: uses LOCAL_DATABASE_URL first, then LOCAL_DB_*, then DB_* for backwards compatibility.

# Production PostgreSQL connection, for example Supabase.
# Use DATABASE_URL if your host provides it; DB_* can be used as a fallback.
# DATABASE_URL=postgresql://user:password@host:5432/database
# DB_HOST=aws-0-region.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.project_ref
# DB_PASSWORD=your_supabase_password
# DB_SSL=true

# Local PostgreSQL connection. Set DATABASE_MODE=local to use it.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_DATABASE=pvp_tetris
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=postgres
LOCAL_DB_SSL=false
# LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pvp_tetris

# Recommended for Render Free: HTTPS email API, not SMTP ports 25/465/587.
# Pick one provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your_brevo_api_key

EMAIL_FROM=PVP Tetris <noreply@your-domain.com>
EMAIL_FROM_NAME=PVP Tetris
SUPPORT_REPLY_TO=support@your-domain.com

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_name
# Comma-separated private chat ids for admins who should receive support tickets
ADMIN_TELEGRAM_CHAT_ID=123456789,987654321
ADMIN_URL=https://admin.pvp-tetris.online

# SMTP fallback for local development or paid hosts that allow SMTP.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=your_google_email@gmail.com
EMAIL_PASS=your_google_app_password


TURNSTILE_SECRET_KEY=your_turnstile_secret_key
